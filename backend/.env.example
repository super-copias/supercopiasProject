# Configuración de Base de Datos PostgreSQL para SuperCopias
# Asegúrate de cambiar estos valores según tu configuración local

# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=supercopias

# Configuración del Pool de Conexiones
DB_CONNECTION_LIMIT=10
DB_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000

# Configuración del Entorno
NODE_ENV=development

# JWT Secret para autenticación
JWT_SECRET=supercopias_secret_key_2024

# Configuración del Servidor
PORT=3001