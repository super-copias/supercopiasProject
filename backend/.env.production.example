# Configuración de Producción - SuperCopias Backend
# IMPORTANTE: NO SUBIR ESTE ARCHIVO A REPOSITORIO

# Base de Datos PostgreSQL (Producción)
DB_HOST=tu-servidor-postgres.com
DB_PORT=5432
DB_USER=supercopias_user
DB_PASSWORD=password_seguro_produccion
DB_NAME=supercopias_prod

# Pool de Conexiones (Optimizado para producción)
DB_CONNECTION_LIMIT=20
DB_TIMEOUT=30000
DB_ACQUIRE_TIMEOUT=30000

# JWT Secret (¡CAMBIAR EN PRODUCCIÓN!)
JWT_SECRET=tu_clave_super_secreta_produccion_2024_muy_larga_y_segura

# Servidor (Producción)
PORT=3000
NODE_ENV=production

# Archivos (Producción)
UPLOAD_PATH=/var/uploads
MAX_FILE_SIZE=10485760

# Logs (Producción)
LOG_LEVEL=warn
LOG_FILE=/var/log/supercopias/app.log

# Sesión
SESSION_TIMEOUT=3600000

# Frontend URLs (Producción)
FRONTEND_URL=https://tu-dominio.com
ALLOWED_ORIGINS=https://tu-dominio.com