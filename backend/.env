# ===================================
# SUPERCOPIAS - AMBIENTE LOCAL (DEV)
# ===================================
# Este archivo NO se sube a QA/Production

# Base de Datos PostgreSQL Local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=supercopias

# Pool de Conexiones
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# Seguridad JWT (cambiar en producción)
JWT_SECRET=dev_secret_key_local_2024

# Servidor
PORT=3000
NODE_ENV=development

# Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Frontend (CORS)
FRONTEND_URL=http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Logs (nivel debug para desarrollo)
LOG_LEVEL=debug