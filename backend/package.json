{
  "name": "supercopias-backend",
  "version": "0.1.0",
  "description": "API REST para Super Copias - Ambiente de Desarrollo",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup-db": "psql -U postgres -d supercopias -f BD_SUPERCOPIAS.sql",
    "db:create": "psql -U postgres -c \"CREATE DATABASE supercopias;\"",
    "db:drop": "psql -U postgres -c \"DROP DATABASE IF EXISTS supercopias;\""
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.4",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
