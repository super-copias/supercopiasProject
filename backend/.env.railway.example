# ⚠️ IMPORTANTE: Este archivo NO se sube a Railway directamente
# Railway usa su propio sistema de variables de entorno
# Estas son las variables que debes configurar en Railway Dashboard

# ========================================
# VARIABLES DE ENTORNO PARA RAILWAY
# ========================================

# 🔐 JWT Configuration
JWT_SECRET=supercopias_production_secret_2024_railway_secure_key_123456

# 🌐 Server Configuration
PORT=3000
NODE_ENV=production

# 📁 File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# 📊 Logging Configuration
LOG_LEVEL=info

# ⏱️ Session Configuration
SESSION_TIMEOUT=86400000

# 🌍 Frontend URL (ACTUALIZAR después del deployment del frontend)
FRONTEND_URL=https://tu-frontend.railway.app
ALLOWED_ORIGINS=https://tu-frontend.railway.app

# ========================================
# NOTAS IMPORTANTES:
# ========================================
# 
# 1. DATABASE_URL es proporcionado automáticamente por Railway cuando agregas PostgreSQL
#    NO necesitas configurarlo manualmente
#
# 2. Para configurar estas variables en Railway:
#    - Ve a tu proyecto en Railway
#    - Selecciona tu servicio (backend)
#    - Click en "Variables"
#    - Click en "Raw Editor"
#    - Copia y pega las variables de arriba
#    - Actualiza FRONTEND_URL con la URL real de tu frontend
#
# 3. Para generar un JWT_SECRET seguro, puedes usar:
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 4. Railway reinicia automáticamente tu aplicación cuando cambias variables
#
