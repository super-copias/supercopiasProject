# ===================================
# SUPERCOPIAS - .gitignore
# ===================================

# Angular
.angular/
dist/
*.tsbuildinfo

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Environment files (NUNCA SUBIR A GIT)
.env
.env.local
.env.development
.env.production
backend/.env
backend/.env.local
backend/.env.development
backend/.env.production
frontend/.env*

# Uploads y archivos temporales
backend/uploads/
backend/uploads/profiles/*
!backend/uploads/profiles/.gitkeep
*.tmp
*.temp

# Logs
*.log
logs/
backend/logs/

# Base de datos (archivos locales de desarrollo)
backend/db.json
backend/db.backup.json
*.sqlite
*.db

# Archivos de prueba y temporales
test-*.js
temp-*.js
check-*.js
*_backup.*
*.backup

# IDEs
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build artifacts
build/
dist/
*.tgz
*.tar.gz

# Coverage reports
coverage/
*.lcov
.nyc_output

# PM2
.pm2/

# Railway (producción)
railway.json
.railway/
